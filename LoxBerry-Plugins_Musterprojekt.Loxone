					</C>
					<C Type="VirtualHttpInCmd" Desc="Verbrauch über den letzten abgeschlossenen Fahrabschnitt. Gerechnet aus Ladezustand, Kilometerstand und Batteriekapazität, erst ab 20 gefahrenen Kilometern — darunter ist die Zahl Rauschen, weil der Ladezustand nur in ganzen Prozent gemeldet wird. [kWh/100km]" IName="VCI1303" V="178" U="a4ced0f0-de40-9c38-c4f1db6889135a88" Title="VW_1_VERBRAUCH" Cl="238,238,238" Nio="2" WF="16400" ValOT="1" Check="\i;VERBRAUCH=\i\v" Analog="true" SourceValHigh="1" DestValHigh="1" MaxVal="200">
