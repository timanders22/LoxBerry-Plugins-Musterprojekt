					</C>
					<C Type="VirtualHttpInCmd" Desc="Minuten seit der letzten Änderung des Fahrzeugzustands. Gerechnet aus dem Änderungszeitpunkt, nicht aus dem Abrufzeitpunkt — sonst wäre der Wert bei jedem Abruf null. [min]" IName="VCI1299" V="178" U="1ef71fa0-7ecc-5396-8d461d00f5cb2a6d" Title="VW_1_STANDZEIT" Cl="238,238,238" Nio="2" WF="16400" ValOT="1" Check="\i;STANDZEIT=\i\v" Analog="true" SourceValHigh="1" DestValHigh="1" MaxVal="2147483647">
