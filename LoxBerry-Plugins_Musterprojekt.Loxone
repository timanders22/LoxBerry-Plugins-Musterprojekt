						<Display Type="2" Unit="&lt;v.1&gt;" StateOnly="true"/>
					</C>
					<C Type="VirtualHttpInCmd" Desc="Fehlgeschlagene Abrufe in Folge. 0 heißt: der letzte saß. Trennt einen kurzen Aussetzer von einer Dauerstörung." IName="VCI1296" V="178" U="9c0c8b79-cc32-c0c6-6d1917c10036daae" Title="VW_1_FEHLFOLGE" Cl="238,238,238" Nio="2" WF="16400" ValOT="1" Check="\i;FEHLFOLGE=\i\v" Analog="true" SourceValHigh="1" DestValHigh="1" MaxVal="100000">
