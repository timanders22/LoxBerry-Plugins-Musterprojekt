						<Display Type="2" Unit="&lt;v.1&gt;" StateOnly="true"/>
					</C>
					<C Type="VirtualHttpInCmd" Desc="1 = das Fahrzeug steht im eingestellten Umkreis um den Heimatort. Ohne hinterlegten Heimatort bleibt das Feld leer." IName="VCI1297" V="178" U="c911be85-6413-5e59-5c1fedd0259d935e" Title="VW_1_ZUHAUSE" Cl="238,238,238" Nio="2" WF="16400" ValOT="1" Check="\i;ZUHAUSE=\i\v" SourceValHigh="1" DestValHigh="1" MaxVal="1">
